---
import WidgetLayout from "./WidgetLayout.astro";
import { quotes } from "../../data/space";

interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;
---
<WidgetLayout name="随机语录" id="random-quote" class={className} style={style}>
	<div class="flex flex-col gap-3 py-1">
		<p id="random-quote-text" class="text-75 text-sm leading-7 m-0">{quotes[0].text}</p>
		<div class="flex items-center justify-between gap-3">
			<span id="random-quote-source" class="text-50 text-xs">{quotes[0].source}</span>
			<button id="random-quote-next" class="btn-plain rounded-lg h-8 px-2 text-xs" type="button" aria-label="换一句">
				换一句
			</button>
		</div>
	</div>
</WidgetLayout>

<script define:vars={{ quoteList: quotes }}>
	const quoteText = document.getElementById("random-quote-text");
	const quoteSource = document.getElementById("random-quote-source");
	const quoteNext = document.getElementById("random-quote-next");
	let lastQuoteIndex = 0;

	quoteNext?.addEventListener("click", () => {
		if (!quoteText || quoteList.length < 2) return;
		let nextIndex = lastQuoteIndex;
		while (nextIndex === lastQuoteIndex) {
			nextIndex = Math.floor(Math.random() * quoteList.length);
		}
		lastQuoteIndex = nextIndex;
		quoteText.textContent = quoteList[nextIndex].text;
		if (quoteSource) quoteSource.textContent = quoteList[nextIndex].source;
	});
</script>
